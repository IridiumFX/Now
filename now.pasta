{
  group:    "dev.iridium",
  artifact: "now",
  version:  "1.0.0-rc4",
  langs:    ["c"],
  std:      "c11",
  output:   { type: "executable", name: "now" },

  sources: {
    dir:     "src/main/c",
    headers: "src/main/h",
    private: "src/main/h/internal"
  },

  components: [
    "components/enterprise",
    "components/export",
    "components/plugins",
    "components/crypto",
    "components/cli"
  ],

  vendored: [
    "lib/basta",
    "lib/alforno",
    "lib/apennines",
    "lib/pico_http"
  ],

  compile: {
    warnings: ["Wall", "Wextra"],
    includes: ["lib/basta/src/main/h", "lib/basta/src/main/c"],
    ; PICO_HTTP_APENNINES selects the apennines HTTPS backend behind the
    ; pico_http API. CMakeLists.txt has defined it since rc3; this file
    ; did not, so `now build` and `cmake --build` produced binaries with
    ; different HTTP stacks — the CMake one on apennines TLS 1.3, the
    ; self-hosted one on pico's native transport. Same source, different
    ; network behaviour, depending only on which build you ran.
    defines:  ["NOW_STATIC", "PICO_HTTP_STATIC", "PICO_HTTP_APENNINES",
               "ALF_STATIC", "BASTA_STATIC", "APENNINES_STATIC"],

    ; glibc hides clock_gettime, strdup, setenv, realpath, struct
    ; timespec st_mtim, etc. behind these under strict -std=c11.
    ; _DEFAULT_SOURCE re-enables BSD-isms (usleep, useconds_t).
    ; macOS/BSD expose them by default (and use st_mtimespec), so
    ; these are Linux-only - mirrors CMakeLists.txt.
    linux: {
      defines: ["_POSIX_C_SOURCE=200809L", "_DEFAULT_SOURCE"]
    }
  },

  link: {
    ; ws2_32 (Winsock) + bcrypt (CNG) are Windows-only. pthreads live
    ; in libc on modern glibc and on macOS, but FreeBSD keeps them in
    ; libthr - -pthread covers all POSIX targets harmlessly.
    windows: { libs: ["ws2_32", "bcrypt"] },
    posix:   { flags: ["-pthread"] }
  },

  ; now_test.c falls back to NOW_TEST_RESOURCES "." when this is not
  ; set, which silently turns every fixture-loading test into a
  ; failure.
  ;
  ; ${project.dir} expands to this project's absolute directory. A
  ; relative path would be enough for tests that merely open a fixture,
  ; but the libdir-cap test hands this path to a nested workspace build
  ; that re-resolves it against its own base — so it has to be
  ; absolute, and it must not be hardcoded to one machine.
  ;
  ; The triple-quoted form is required because Pasta strings have no
  ; escape sequences and the value must reach the compiler quoted; the
  ; trailing space keeps its closing quote from merging with the
  ; closing delimiter.
  tests: {
    dir: "src/test/c",
    defines: ["""NOW_TEST_RESOURCES="${project.dir}/src/test/resources" """]
  },

  profiles: {
    debug:   { compile: { flags: ["-g", "-O0"], defines: ["DEBUG"] } },
    release: { compile: { flags: ["-O2"] }, link: { flags: ["-s"] } }
  }
}
